# ── SearXNG instance ─────────────────────────────────────────────
# URL of the SearXNG instance (default: localhost for single-container)
MCP_SEARXNG_BASE_URL=http://127.0.0.1:8080

# ── Server settings ─────────────────────────────────────────────
MCP_SEARXNG_HOST=0.0.0.0
MCP_SEARXNG_PORT=8101
MCP_SEARXNG_LOG_LEVEL=info
MCP_SEARXNG_ENVIRONMENT=production

# Optional: require a bearer token for incoming requests from the
# MCP hub.  If blank, all requests are accepted.
MCP_SEARXNG_AUTH_TOKEN=

# ── SearXNG tuning ──────────────────────────────────────────────
# MCP_SEARXNG_REQUEST_TIMEOUT=15
# MCP_SEARXNG_DEFAULT_RESULT_COUNT=10
# MCP_SEARXNG_MAX_RESULT_COUNT=50

# ── Observability ───────────────────────────────────────────────
# MCP_SEARXNG_SENTRY_DSN=
# MCP_SEARXNG_OPENTELEMETRY_ENDPOINT=
